{:paths ["src"]
 ;; multiformats stays a direct dep (boundary hashing); node encode/decode
 ;; goes through ipld (tag-42 links), which brings dag-cbor transitively.
 :deps {io.github.kotoba-lang/io-multiformats {:git/sha "b3b157e683a943d4f2e9362d9366cceefff3f656"}
        io.github.kotoba-lang/io-ipld {:git/sha "f99bf27d58a75bb8cf6ddfd2d57a0aaac9c824ac"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
       ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
       :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
